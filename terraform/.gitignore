
# ==========================================
# Terraform generated files
# ==========================================

# Terraform working directory (providers and modules)
**/.terraform/*

# Terraform state files (may contain sensitive data)
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Terraform saved plans (may contain sensitive data)
*.tfplan
*.tfplan.*

# Terraform transient lock information
.terraform.tfstate.lock.info

# ==========================================
# Sensitive variable files
# ==========================================

# Variable files - may contain credentials or secrets
*.tfvars
*.tfvars.json

# ==========================================
# Terraform override files
# ==========================================

override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ==========================================
# Terraform CLI configuration
# ==========================================

.terraformrc
terraform.rc
